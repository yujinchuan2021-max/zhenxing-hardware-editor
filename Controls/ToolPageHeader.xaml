<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TubaWinUi3.Controls.ToolPageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,22,24,18" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="HeaderIcon" FontSize="30" VerticalAlignment="Center"
                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock x:Name="HeaderTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="HeaderSubtitle" FontSize="13" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
