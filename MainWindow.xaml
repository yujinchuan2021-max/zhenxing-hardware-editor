<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TubaWinUi3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TubaWinUi3.Pages"
    Title="枕星配置修改器">
    <Grid x:Name="RootGrid" RequestedTheme="Default"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="24,8" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="枕星配置修改器 · 0.1.0" FontWeight="SemiBold"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <ComboBox x:Name="ThemePicker" Grid.Column="1" MinWidth="130"
                          AutomationProperties.Name="界面主题" SelectedIndex="0"
                          SelectionChanged="ThemePicker_SelectionChanged">
                    <ComboBoxItem Content="跟随系统" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="深色" />
                </ComboBox>
            </Grid>
        </Border>
        <pages:HardwareSpooferPage x:Name="EditorPage" Grid.Row="1" Margin="0,16,0,0" />
    </Grid>
</Window>
